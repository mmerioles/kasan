# The passcode you type on your phone. CHANGE THIS.
KASAN_PASSCODE=change-me

# Directories kasan is allowed to open sessions in (comma separated,
# as seen from INSIDE the container).
KASAN_WORKSPACE=/workspace

# Port the web UI listens on.
KASAN_PORT=7777

# Where the host keeps the repos you want to work on. Mounted at /workspace.
HOST_WORKSPACE=${HOME}/repos

# Kill an idle agent process after this many minutes (its conversation is
# kept and resumes on your next message). 0 disables.
KASAN_IDLE_MINUTES=60

# --- signing the agents in ------------------------------------------------
# The easiest route: run these on any machine that HAS a browser (your laptop),
# then paste the result here. No terminal juggling inside the container.
#
#   claude setup-token          -> CLAUDE_CODE_OAUTH_TOKEN
#
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#
# Or use plain API keys instead:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
